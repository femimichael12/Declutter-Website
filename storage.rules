rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Product Authentic Photos:
    // Anyone can view and load authentic product images on the storefront.
    // Only authenticated users/administrators can upload, replace, or delete product photos.
    match /products/{productId}/{allPaths=**} {
      allow read: if true;
      allow write, delete: if isAuthenticated();
    }

    // Category and Banner Assets
    match /categories/{allPaths=**} {
      allow read: if true;
      allow write, delete: if isAuthenticated();
    }
    match /banners/{allPaths=**} {
      allow read: if true;
      allow write, delete: if isAuthenticated();
    }

    // User Avatars
    match /avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow write, delete: if isAuthenticated() && request.auth.uid == userId;
    }
  }
}
